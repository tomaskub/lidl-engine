POSTGRES_PASSWORD=replace-with-a-local-password
# URL-encode the password when putting it in this connection URL.
DATABASE_URL=postgresql://lidl:replace-with-a-local-password@db:5432/lidl
EVIDENCE_DIR=/data/evidence
# Choose currently available batch-capable models. Credentials are only needed for live refresh.
OPENROUTER_API_KEY=
DESCRIPTION_MODEL=
EXTRACTION_MODEL=
# Optional provider pinning, e.g. deepinfra, with public image URL support.
BATCH_PROVIDER=
POLL_SECONDS=30
# Set the server's household LAN IP to allow local-network browsing.
LIDL_BIND_ADDRESS=127.0.0.1
